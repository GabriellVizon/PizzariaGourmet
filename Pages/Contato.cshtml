@page
@{
    Layout = "_Layout";
}

<div class="container" style="max-width:600px;margin:40px auto">
  <h2 style="text-align:center;margin-bottom:24px">Fale Conosco</h2>

  <div class="admin-panel" style="margin-bottom:20px">
    <h3 style="margin-bottom:12px;color:var(--brand)">WhatsApp</h3>
    <p style="color:var(--text)">
      O canal mais rápido para atendimento e pedidos:
    </p>
    <a href="https://wa.me/5524992206707?text=Oi!%20Gostaria%20de%20fazer%20um%20pedido" 
       class="btn-checkout" 
       style="display:inline-block;text-decoration:none;margin-top:8px">
      Abrir WhatsApp
    </a>
  </div>

  <div class="admin-panel" style="margin-bottom:20px">
    <h3 style="margin-bottom:12px;color:var(--brand)">Endereço</h3>
    <p style="color:var(--text)">
      Rua Exemplo, 123 - Centro<br>
      Paraíba do Sul - RJ
    </p>
  </div>

  <div class="admin-panel">
    <h3 style="margin-bottom:12px;color:var(--brand)">Horário de Funcionamento</h3>
    <p style="color:var(--text)">
      Terça a Sábado: 17h às 23h59<br>
      Domingo: 18h às 23h59<br>
      Segunda: Fechado
    </p>
  </div>
</div>
