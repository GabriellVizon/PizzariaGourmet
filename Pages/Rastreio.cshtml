@page
@model RastreioModel
@{
    Layout = "_Layout";
}

<div class="container" style="max-width:640px;margin:32px auto">
  <h2 style="text-align:center">📦 Rastrear Pedido</h2>
  <p style="text-align:center;color:var(--text-light);margin-bottom:24px">Consulte o status do seu pedido informando seu telefone ou o número do pedido.</p>

  <form method="post" class="admin-panel" style="margin-bottom:20px">
    <div class="form-group">
      <label for="telefone">Telefone (WhatsApp)</label>
      <input id="telefone" name="Telefone" value="@Model.Telefone" placeholder="(24) 99999-9999" />
      <small style="color:var(--text-light)">Ou informe o número do pedido abaixo</small>
    </div>

    <div style="text-align:center;margin:8px 0;color:var(--text-light)">— ou —</div>

    <div class="form-group">
      <label for="pedidoId">Número do Pedido</label>
      <input id="pedidoId" name="PedidoId" value="@Model.PedidoId" placeholder="Ex: a1b2c3d4-e5f6..." />
    </div>

    <button type="submit" class="btn-checkout" style="margin-top:12px;width:100%">Consultar</button>
  </form>

  @if (Model.Buscou)
  {
    if (Model.Pedidos.Count == 0)
    {
      <div class="admin-panel" style="text-align:center;color:var(--text-light)">
        Nenhum pedido encontrado. Verifique o telefone ou número informado.
      </div>
    }
    else
    {
      @foreach (var pedido in Model.Pedidos)
      {
        <div class="admin-panel">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
            <div>
              <strong style="font-size:1.1rem">Pedido #@pedido.Id[..8]</strong>
              <div style="font-size:0.85rem;color:var(--text-light)">@pedido.CreatedAt</div>
            </div>
            @{
              var statusLabel = pedido.Status switch
              {
                "pending" => "Pendente",
                "paid" => "Pago",
                "preparing" => "Preparando",
                "delivering" => "Saiu para entrega",
                "delivered" => "Entregue",
                "cancelled" => "Cancelado",
                _ => pedido.Status
              };
              var statusColor = pedido.Status switch
              {
                "paid" => "#27ae60",
                "preparing" => "#f39c12",
                "delivering" => "#3498db",
                "delivered" => "#27ae60",
                "cancelled" => "#e74c3c",
                _ => "var(--accent)"
              };
            }
            <span style="display:inline-block;padding:4px 14px;border-radius:50px;font-size:0.85rem;font-weight:700;background:@statusColor;color:#fff">@statusLabel</span>
          </div>

          <div style="margin-top:16px">
            <div style="display:flex;gap:4px;align-items:center">
              @{
                var steps = new[] {
                  ("pending", "📋", "Pedido Recebido"),
                  ("paid", "✅", "Pagamento Confirmado"),
                  ("preparing", "🍕", "Preparando"),
                  ("delivering", "🚚", "Saiu pra Entrega"),
                  ("delivered", "📦", "Entregue")
                };
                var currentIdx = Array.FindIndex(steps, s => s.Item1 == pedido.Status);
                var isCancelled = pedido.Status == "cancelled";
              }

              <div style="display:flex;gap:0;width:100%;align-items:center">
                @for (int i = 0; i < steps.Length; i++)
                {
                  var done = i <= currentIdx;
                  <div style="flex:1;text-align:center;position:relative">
                    <div style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:1rem;background:@(done ? "#27ae60" : "var(--bg)");color:@(done ? "#fff" : "var(--text-light)");border:2px solid @(done ? "#27ae60" : "var(--border)")">
                      @if (isCancelled && i > currentIdx)
                      {
                        <span>✕</span>
                      }
                      else
                      {
                        @steps[i].Item2
                      }
                    </div>
                    <div style="font-size:0.7rem;margin-top:4px;color:@(done ? "var(--text)" : "var(--text-light)");font-weight:@(done ? "700" : "400")">@steps[i].Item3</div>
                  </div>
                  @if (i < steps.Length - 1)
                  {
                    <div style="flex:0 0 16px;height:2px;background:@(i < currentIdx ? "#27ae60" : "var(--border)");margin-bottom:20px"></div>
                  }
                }
              </div>
            </div>

            @if (isCancelled)
            {
              <div style="margin-top:12px;padding:8px 12px;background:#fde8e8;border-radius:8px;color:#e74c3c;font-size:0.85rem;text-align:center;font-weight:600">Este pedido foi cancelado.</div>
            }
          </div>

          <div style="margin-top:12px;font-size:0.9rem;display:flex;gap:16px;flex-wrap:wrap">
            <span><strong>Total:</strong> R$ @pedido.Total.ToString("F2")</span>
            <span><strong>Pagamento:</strong> @(pedido.PaymentMethod switch { "card" => "Cartão de Crédito", "pix" => "PIX", "cash" => "Dinheiro", _ => pedido.PaymentMethod })</span>
          </div>

          @if (pedido.Status == "pending" || pedido.Status == "paid")
          {
            <div style="margin-top:12px;border-top:1px solid var(--border);padding-top:12px;display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap">
              <button onclick="reorder('@pedido.Items.Replace("'", "\\'")')" style="padding:8px 20px;background:var(--accent);color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer;font-size:0.85rem">
                🔄 Pedir Novamente
              </button>
              <form method="post" asp-page-handler="cancel" onsubmit="return confirm('Tem certeza que deseja cancelar este pedido?')">
                <input type="hidden" name="orderId" value="@pedido.Id" />
                <input type="hidden" name="telefone" value="@Model.Telefone" />
                <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                <button type="submit" style="padding:8px 20px;background:#e74c3c;color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer;font-size:0.85rem">
                  Cancelar Pedido
                </button>
              </form>
            </div>
          }
          else if (pedido.Status == "delivered" || pedido.Status == "cancelled")
          {
            <div style="margin-top:12px;border-top:1px solid var(--border);padding-top:12px;text-align:right">
              <button onclick="reorder('@pedido.Items.Replace("'", "\\'")')" style="padding:8px 20px;background:var(--accent);color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer;font-size:0.85rem">
                🔄 Pedir Novamente
              </button>
            </div>
          }
        </div>
      }

      @if (!string.IsNullOrEmpty(Model.CancelResult))
      {
        <div class="admin-panel" style="margin-top:16px;text-align:center;background:#e8f5e9;border:2px solid #27ae60">
          <span style="color:#27ae60;font-weight:700">@Model.CancelResult</span>
        </div>
      }
    }
  }
</div>

<script>
function reorder(itemsJson) {
  try {
    const data = JSON.parse(itemsJson);
    let cart = [];

    if (Array.isArray(data)) {
      cart = data;
    } else if (data.cart && Array.isArray(data.cart)) {
      cart = data.cart;
    }

    if (cart.length === 0) {
      alert('Não foi possível recuperar os itens do pedido.');
      return;
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    window.location.href = '/Carrinho';
  } catch (e) {
    alert('Erro ao recuperar itens do pedido.');
  }
}
</script>
