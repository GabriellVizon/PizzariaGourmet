@page
@{
  Layout = "_Layout";
}

<div class="checkout-page">
  <div class="container">
    <div class="checkout-grid">
      <div class="checkout-form-wrap">
        <h2>📋 Dados da Entrega</h2>
        <form id="checkout-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nome completo</label>
              <input id="name" name="name" required placeholder="Seu nome" />
            </div>
            <div class="form-group">
              <label for="phone">Telefone / WhatsApp</label>
              <input id="phone" name="phone" required placeholder="(24) 99999-9999" />
            </div>
          </div>
            <div class="form-group">
              <label for="email">E-mail <span style="color:var(--text-light);font-weight:400">(opcional)</span></label>
              <input id="email" name="email" type="email" placeholder="seu@email.com" />
            </div>
            <div class="form-group">
              <label for="cep">CEP <span style="color:var(--text-light);font-weight:400">(para verificar área de entrega)</span></label>
              <input id="cep" name="cep" placeholder="00000-000" maxlength="9" />
            </div>
            <div id="cep-validation" style="font-size:0.85rem;margin-bottom:8px;display:none"></div>
            <div class="form-group">
              <label for="address">Endereço de entrega</label>
            <input id="address" name="address" required placeholder="Rua, número, bairro, complemento" />
          </div>
          <div class="form-group">
            <label for="cpf">CPF (para nota fiscal)</label>
            <input id="cpf" name="cpf" placeholder="000.000.000-00" />
          </div>
          <div class="form-group">
            <label for="notes">Observações</label>
            <textarea id="notes" name="notes" placeholder="Alguma observação? Ex: sem cebola, ponto da massa..."></textarea>
          </div>

          <div id="store-status" style="margin-bottom:16px"></div>

          <div id="scheduling-section" style="margin-bottom:16px;display:none">
            <h2>📅 Agendamento</h2>
            <p style="font-size:0.85rem;color:var(--text-light);margin-bottom:8px">Agende seu pedido para receber no horário desejado:</p>
            <div class="form-row">
              <div class="form-group">
                <label for="schedule-date">Data</label>
                <input id="schedule-date" type="date" />
              </div>
              <div class="form-group">
                <label for="schedule-time">Horário</label>
                <input id="schedule-time" type="time" />
              </div>
            </div>
            <small style="color:var(--text-light)">Deixe em branco para entrega imediata.</small>
          </div>

          <h2 style="margin-top:32px">💳 Pagamento</h2>
          <input type="hidden" id="payment-method" name="paymentMethod" value="card" />
          <div class="payment-options">
            <div class="payment-option selected" data-method="card">
              <span class="pay-icon">💳</span>
              Cartão de Crédito
            </div>
            <div class="payment-option" data-method="pix">
              <span class="pay-icon">📱</span>
              Pix
            </div>
            <div class="payment-option" data-method="cash">
              <span class="pay-icon">💵</span>
              Dinheiro
            </div>
          </div>

          <div class="payment-detail payment-detail-card" id="payment-detail-card">
            <div class="card-info-box">
              <div class="card-info-icon">💳</div>
              <div class="card-info-text">
                <strong>Cartão de Crédito</strong>
                <p style="margin:4px 0 0;font-size:0.85rem">Pagamento na entrega (maquininha). Seu pedido será registrado e o pagamento será coletado no momento da entrega.</p>
              </div>
            </div>
          </div>

          <div class="payment-detail payment-detail-pix" id="payment-detail-pix">
            <div class="pix-qr-placeholder">
              <div class="pix-qr-box" id="pix-qr-box"></div>
              <p class="pix-instruction">Escaneie o código QR abaixo com seu aplicativo do banco</p>
              <span class="pix-key-text">contato@dompizzaria.com</span>
              <p style="font-size:0.8rem;color:var(--text-light);margin-top:8px">⏳ O pagamento será confirmado manualmente após a transferência.</p>
            </div>
          </div>

          <div class="payment-detail payment-detail-cash" id="payment-detail-cash">
            <div class="cash-input-row">
              <label for="cash-amount">Quantia em dinheiro</label>
              <input id="cash-amount" name="cashAmount" type="number" step="0.01" min="0" placeholder="R$ 0,00" />
            </div>
            <div class="cash-change-display" id="cash-change-display">
              <div class="cash-change-label">Troco</div>
              <div class="cash-change-amount" id="cash-change-amount">R$ 0,00</div>
            </div>
          </div>

          <div style="margin-top:24px">
            <button type="submit" class="btn-checkout">
              Confirmar Pedido →
            </button>
          </div>
        </form>
        <div id="checkout-result" style="margin-top:16px"></div>
      </div>

      <div>
        <div class="checkout-summary">
          <h3>📄 Resumo do Pedido</h3>
          <div id="checkout-items"></div>
          <div class="checkout-summary-item">
            <span>Subtotal</span>
            <span id="checkout-subtotal" style="font-weight:600">R$ 0,00</span>
          </div>
          <div class="checkout-coupon">
            <input id="coupon-input" placeholder="Cupom de desconto" style="flex:1" />
            <button id="coupon-apply" type="button" style="padding:8px 16px;background:var(--brand);color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer">Aplicar</button>
          </div>
          <div id="coupon-result" style="font-size:0.85rem;margin-bottom:8px"></div>
          <div class="checkout-summary-item" id="checkout-discount-row" style="display:none">
            <span>Desconto</span>
            <span id="checkout-discount" style="font-weight:600;color:var(--accent)">-R$ 0,00</span>
          </div>
          <div class="checkout-summary-item">
            <span>Taxa de entrega</span>
            <span id="checkout-delivery" style="font-weight:600">R$ 0,00</span>
          </div>
          <div class="checkout-summary-total">
            <span>Total</span>
            <span class="cs-total-amount" id="checkout-total">R$ 0,00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let DELIVERY_FEE = 5.00;
let FREE_DELIVERY_MIN = 50.00;
let appliedCoupon = null;

function formatPrice(p) {
  return p.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function getItemTotal(item) {
  const base = item.price * item.qty;
  const comps = item.complements ? item.complements.reduce((s, c) => s + c.price, 0) * item.qty : 0;
  return base + comps;
}

function getBaseSubtotal(cart) {
  return cart.reduce((s, i) => s + (i.price * i.qty), 0);
}

function renderCheckoutSummary() {
  const cart = JSON.parse(localStorage.getItem('cart') || '[]');
  const el = document.getElementById('checkout-items');
  const subtotal = cart.reduce((s, i) => s + getItemTotal(i), 0);
  const delivery = getBaseSubtotal(cart) >= FREE_DELIVERY_MIN ? 0 : DELIVERY_FEE;
  const discount = appliedCoupon ? appliedCoupon.discount : 0;
  const total = Math.max(0, subtotal + delivery - discount);

  if (cart.length === 0) {
    el.innerHTML = '<div style="color:var(--text-light);text-align:center;padding:16px 0">Carrinho vazio</div>';
    document.querySelector('.btn-checkout').disabled = true;
  } else {
    el.innerHTML = cart.map(i => {
      const sizeText = i.size ? ` <span style="font-size:0.75rem;font-weight:700;color:var(--accent)">${i.size.name}</span>` : '';
      const compsText = i.complements && i.complements.length > 0
        ? `<span class="cs-comps">+ ${i.complements.map(c => c.name).join(', ')}</span>`
        : '';
      return `
      <div class="checkout-summary-item" style="flex-wrap:wrap">
        <span class="cs-name">${i.name}${sizeText}</span>
        ${compsText}
        <span class="cs-qty">x${i.qty}</span>
        <span class="cs-price">R$ ${formatPrice(getItemTotal(i))}</span>
      </div>`;
    }).join('');
  }

  const discountRow = document.getElementById('checkout-discount-row');
  if (discount > 0) {
    discountRow.style.display = 'flex';
    document.getElementById('checkout-discount').textContent = `-R$ ${formatPrice(discount)}`;
  } else {
    discountRow.style.display = 'none';
  }

  document.getElementById('checkout-subtotal').textContent = `R$ ${formatPrice(subtotal)}`;
  document.getElementById('checkout-delivery').textContent = delivery === 0 ? 'Grátis' : `R$ ${formatPrice(delivery)}`;
  document.getElementById('checkout-total').textContent = `R$ ${formatPrice(total)}`;
}

(async () => {
  try {
    const res = await fetch('/api/settings');
    const data = await res.json();
    DELIVERY_FEE = data.deliveryFee;
    FREE_DELIVERY_MIN = data.freeDeliveryMin;
    if (data.pixKey) PIX_KEY = data.pixKey;
    if (data.whatsapp) WHATSAPP = data.whatsapp;
    if (data.storeName) STORE_NAME = data.storeName;
  } catch (e) {
    console.error('Erro ao carregar configurações:', e);
  }
  renderCheckoutSummary();

  document.querySelectorAll('.payment-option').forEach(el => {
    el.addEventListener('click', () => {
      document.querySelectorAll('.payment-option').forEach(o => o.classList.remove('selected'));
      el.classList.add('selected');
      const method = el.dataset.method;
      document.getElementById('payment-method').value = method;

      document.querySelectorAll('.payment-detail').forEach(d => d.classList.remove('active'));
      const detailEl = document.getElementById('payment-detail-' + method);
      if (detailEl) detailEl.classList.add('active');

      if (method === 'pix') generatePixQrCode();
      if (method === 'cash') updateCashChange();
    });
  });

  // Store status check
  async function checkStoreStatus() {
    try {
      const r = await fetch('/api/business-hours/check');
      const data = await r.json();
      const el = document.getElementById('store-status');
      if (data.isOpen) {
        el.innerHTML = `<div style="padding:8px 12px;background:#e8f5e9;border-radius:8px;font-size:0.85rem;color:#2e7d32;font-weight:600">🟢 Loja aberta — Funcionamento: ${data.openTime} às ${data.closeTime}</div>`;
      } else {
        el.innerHTML = `<div style="padding:8px 12px;background:#fde8e8;border-radius:8px;font-size:0.85rem;color:#c62828;font-weight:600">
          🔴 Loja fechada — Horário: ${data.openTime || '—'} às ${data.closeTime || '—'}<br>
          <span style="font-weight:400">Você pode agendar um pedido para outro horário abaixo.</span>
        </div>`;
        document.getElementById('scheduling-section').style.display = 'block';
      }
      if (data.isOpen) {
        const settingsRes = await fetch('/api/settings');
        const settingsData = await settingsRes.json();
        if (settingsData.allowScheduling !== false) {
          document.getElementById('scheduling-section').style.display = 'block';
        }
      }
    } catch {}
  }

  // Set min date for scheduling
  const dateInput = document.getElementById('schedule-date');
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split('T')[0];
  }

  checkStoreStatus();

  // CEP auto-format and validation
  const cepInput = document.getElementById('cep');
  if (cepInput) {
    cepInput.addEventListener('input', (e) => {
      let val = e.target.value.replace(/\D/g, '');
      if (val.length > 5) val = val.slice(0, 5) + '-' + val.slice(5, 8);
      e.target.value = val;
    });

    cepInput.addEventListener('blur', async (e) => {
      const cep = e.target.value.replace(/\D/g, '');
      const el = document.getElementById('cep-validation');
      if (cep.length === 8) {
        try {
          const r = await fetch(`/api/delivery-areas/check-cep?cep=${cep}`);
          const data = await r.json();
          if (data.valid) {
            el.style.display = 'block';
            el.style.color = '#27ae60';
            el.textContent = `✓ ${data.areaName} — Frete: R$ ${data.deliveryFee.toFixed(2)}${data.estimatedTime ? ` | Entrega estimada: ${data.estimatedTime} min` : ''}`;
          } else {
            el.style.display = 'block';
            el.style.color = '#e74c3c';
            el.textContent = data.areaName ? `✓ ${data.areaName}` : '⚠️ CEP não atendido. Verifique se entregamos no seu endereço.';
          }
        } catch {
          el.style.display = 'none';
        }
      } else {
        el.style.display = 'none';
      }
    });
  }

  function getTotal() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const subtotal = cart.reduce((s, i) => s + getItemTotal(i), 0);
    const delivery = getBaseSubtotal(cart) >= FREE_DELIVERY_MIN ? 0 : DELIVERY_FEE;
    return subtotal + delivery;
  }

  function updateCashChange() {
    const total = getTotal();
    const input = document.getElementById('cash-amount');
    const display = document.getElementById('cash-change-display');
    const amountEl = document.getElementById('cash-change-amount');
    const paid = parseFloat(input.value) || 0;
    if (paid >= total) {
      const change = paid - total;
      amountEl.textContent = 'R$ ' + formatPrice(change);
      display.classList.add('active');
    } else {
      display.classList.remove('active');
    }
  }

  document.getElementById('cash-amount')?.addEventListener('input', updateCashChange);

  document.getElementById('payment-detail-card')?.classList.add('active');

  // Coupon
  document.getElementById('coupon-apply')?.addEventListener('click', async () => {
    const input = document.getElementById('coupon-input');
    const code = input.value.trim();
    if (!code) return;

    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const subtotal = cart.reduce((s, i) => s + getItemTotal(i), 0);

    try {
      const res = await fetch(`/api/coupons/validate?code=${encodeURIComponent(code)}&subtotal=${subtotal}`);
      const data = await res.json();
      const resultEl = document.getElementById('coupon-result');

      if (data.valid) {
        appliedCoupon = data;
        resultEl.innerHTML = `<span style="color:#27ae60;font-weight:600">✓ Cupom aplicado! (-R$ ${formatPrice(data.discount)})</span>`;
        input.disabled = true;
        document.getElementById('coupon-apply').disabled = true;
        renderCheckoutSummary();
      } else {
        appliedCoupon = null;
        resultEl.innerHTML = `<span style="color:var(--brand)">${data.error || 'Cupom inválido'}</span>`;
      }
    } catch {
      document.getElementById('coupon-result').innerHTML = `<span style="color:var(--brand)">Erro ao validar cupom</span>`;
    }
  });

  function crc16CCITT(data) {
    let crc = 0xFFFF;
    for (let i = 0; i < data.length; i++) {
      crc ^= data.charCodeAt(i) << 8;
      for (let j = 0; j < 8; j++) {
        if (crc & 0x8000) crc = (crc << 1) ^ 0x1021;
        else crc = crc << 1;
        crc &= 0xFFFF;
      }
    }
    return crc.toString(16).toUpperCase().padStart(4, '0');
  }

  function generatePixPayload(total) {
    const pixKey = typeof PIX_KEY !== 'undefined' ? PIX_KEY : 'contato@dompizzaria.com';
    const storeName = typeof STORE_NAME !== 'undefined' ? STORE_NAME.substring(0, 25) : 'DomPizzaria';
    const amount = total.toFixed(2);

    let payload = '000201';
    payload += '010212';
    payload += '26' + String(14 + pixKey.length).padStart(2, '0') + '0014BR.GOV.BCB.PIX01' + String(pixKey.length).padStart(2, '0') + pixKey;
    payload += '52040000';
    payload += '5303986';
    payload += '54' + String(amount.length).padStart(2, '0') + amount;
    payload += '5802BR';
    payload += '59' + String(storeName.length).padStart(2, '0') + storeName;
    payload += '6008Sao Paulo';
    payload += '62070503***';
    payload += '6304';

    const crc = crc16CCITT(payload);
    return payload + crc;
  }

  function generatePixQrCode() {
    const box = document.getElementById('pix-qr-box');
    if (box.querySelector('img')) return;
    const total = getTotal();
    const payload = generatePixPayload(total);
    const img = document.createElement('img');
    img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(payload);
    img.alt = 'QR Code PIX';
    img.style.width = '200px';
    img.style.height = '200px';
    img.onerror = function() {
      this.onerror = null;
      box.innerHTML = '<div style="font-size:3rem;opacity:0.3;text-align:center;padding:20px">📱<br><span style="font-size:0.9rem">QR Code indisponível</span></div>';
    };
    box.innerHTML = '';
    box.appendChild(img);
  }
})();

document.getElementById('checkout-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('.btn-checkout');
  btn.textContent = '⏳ Processando...';
  btn.disabled = true;

  const data = new FormData(e.target);
  const cart = JSON.parse(localStorage.getItem('cart') || '[]');

  if (cart.length === 0) {
    alert('Carrinho vazio!');
    btn.textContent = 'Confirmar Pedido →';
    btn.disabled = false;
    return;
  }

  const scheduleDate = document.getElementById('schedule-date')?.value;
  const scheduleTime = document.getElementById('schedule-time')?.value;
  let scheduledTime = null;
  if (scheduleDate && scheduleTime) {
    scheduledTime = scheduleDate + 'T' + scheduleTime + ':00';
  }

  const payload = {
    customer: {
      name: data.get('name'),
      phone: data.get('phone'),
      email: data.get('email'),
      cep: data.get('cep'),
      address: data.get('address'),
      cpf: data.get('cpf'),
      notes: data.get('notes')
    },
    paymentMethod: data.get('paymentMethod') || 'card',
    cart: cart,
    couponCode: appliedCoupon ? appliedCoupon.code : null,
    scheduledTime: scheduledTime
  };

  try {
    const res = await fetch('/create-checkout-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json();
    if (json?.url) {
      window.location = json.url;
    } else if (json?.storeClosed) {
      document.getElementById('checkout-result').innerHTML =
        `<div style="color:#c62828;padding:16px;background:#fde8e8;border-radius:8px;font-weight:600">🔴 ${json.error}<br><span style="font-weight:400;font-size:0.9rem">Você pode agendar um pedido preenchendo a data e horário acima.</span></div>`;
      btn.textContent = 'Confirmar Pedido →';
      btn.disabled = false;
    } else {
      document.getElementById('checkout-result').innerHTML =
        `<div style="color:var(--brand);padding:12px;background:var(--bg);border-radius:8px">${json.error || 'Erro ao processar pedido'}</div>`;
      btn.textContent = 'Confirmar Pedido →';
      btn.disabled = false;
    }
  } catch (err) {
    document.getElementById('checkout-result').innerHTML =
      `<div style="color:var(--brand)">Erro de conexão. Tente novamente.</div>`;
    btn.textContent = 'Confirmar Pedido →';
    btn.disabled = false;
  }
});
</script>
