<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pizzaria Gourmet - Delivery</title>
  <link rel="stylesheet" href="/css/site.css" />
  <meta name="description" content="Cardápio online da Pizzaria Gourmet - Delivery em Paraíba do Sul" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/">
        <span class="logo-icon">P</span>
        Pizzaria Gourmet
      </a>
      <button class="mobile-menu-btn" aria-label="Menu">☰</button>
      <nav class="top-nav">
        <a href="/">Cardápio</a>
        <a href="https://wa.me/5524992206707?text=Oi!%20Gostaria%20de%20fazer%20um%20pedido">WhatsApp</a>
        <a href="#" class="nav-cart-btn" data-action="open-cart">
          🛒 Carrinho
          <span class="cart-badge" id="cart-count" style="display:none">0</span>
        </a>
      </nav>
    </div>
  </header>

  <main>@RenderBody()</main>

  <!-- Cart Sidebar -->
  <div id="cart-overlay" class="cart-overlay"></div>
  <div id="cart-sidebar" class="cart-sidebar">
    <div class="cart-header">
      <h3>🛒 Meu Carrinho</h3>
      <button class="cart-close" data-action="close-cart">✕</button>
    </div>
    <div id="cart-items" class="cart-items">
      <div class="cart-empty">
        <div class="cart-empty-icon">🛒</div>
        <div>Seu carrinho está vazio</div>
      </div>
    </div>
    <div class="cart-footer">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <span id="cart-subtotal">R$ 0,00</span>
      </div>
      <div class="cart-delivery" id="cart-delivery">
        <span>Taxa de entrega</span>
        <span>R$ 0,00</span>
      </div>
      <div class="cart-total">
        <span>Total</span>
        <span class="cart-total-amount" id="cart-total">R$ 0,00</span>
      </div>
      <button class="btn-checkout" id="goto-checkout" disabled>
        Finalizar Pedido →
      </button>
    </div>
  </div>

  <!-- Floating Cart (Mobile) -->
  <div id="cart-floating" class="cart-floating" style="display:none">
    <div class="cart-floating-inner">
      <div class="cart-floating-info">
        <span class="cart-floating-count" id="floating-count">0 itens</span>
        <span class="cart-floating-total" id="floating-total">R$ 0,00</span>
      </div>
      <button class="btn-cart-open" data-action="open-cart">🛒 Ver Carrinho</button>
    </div>
  </div>

  <!-- Size Modal -->
  <div id="size-overlay" class="complement-overlay"></div>
  <div id="size-modal" class="size-modal">
    <div class="complement-modal-header">
      <h3 id="size-modal-title">Escolha o Tamanho</h3>
      <button class="complement-modal-close" data-action="close-size">✕</button>
    </div>
    <div class="size-modal-body">
      <div id="size-list" class="size-list"></div>
    </div>
    <div class="complement-modal-footer">
      <button class="btn-complement-confirm" id="size-modal-confirm">
        Continuar →
      </button>
    </div>
  </div>

  <!-- Complement Modal -->
  <div id="complement-overlay" class="complement-overlay"></div>
  <div id="complement-modal" class="complement-modal">
    <div class="complement-modal-header">
      <h3 id="complement-modal-title">Complementos</h3>
      <button class="complement-modal-close" data-action="close-complement">✕</button>
    </div>
    <div class="complement-modal-body">
      <div class="complement-modal-hint">Escolha até <strong>3 complementos</strong> para esta pizza:</div>
      <div id="complement-list" class="complement-list"></div>
    </div>
    <div class="complement-modal-footer">
      <div class="complement-modal-qty-wrap">
        <span class="complement-modal-qty-label">Quantidade</span>
        <div class="complement-modal-qty-controls">
          <button id="complement-modal-dec">−</button>
          <span id="complement-modal-qty">1</span>
          <button id="complement-modal-inc">+</button>
        </div>
      </div>
      <div class="complement-modal-total-row">
        <span class="complement-modal-total-label">Valor unitário</span>
        <span class="complement-modal-total" id="complement-modal-total">R$ 0,00</span>
      </div>
      <button class="btn-complement-confirm" id="complement-modal-confirm">
        Adicionar ao Carrinho
      </button>
    </div>
  </div>

  <footer class="site-footer">© @DateTime.Now.Year Pizzaria Gourmet — Delivery em Paraíba do Sul</footer>

  <script src="/js/site.js"></script>
</body>
</html>
