@page
@model HistoricoModel
@{
    Layout = "_Layout";
}

<div class="container" style="max-width:640px;margin:32px auto">
  <h2 style="text-align:center">📋 Meus Pedidos</h2>
  <p style="text-align:center;color:var(--text-light);margin-bottom:24px">Consulte todos os seus pedidos informando seu telefone.</p>

  <form method="post" class="admin-panel" style="margin-bottom:20px">
    <div class="form-group">
      <label for="telefone">Telefone (WhatsApp)</label>
      <input id="telefone" name="Telefone" value="@Model.Telefone" required placeholder="(24) 99999-9999" />
    </div>
    <button type="submit" class="btn-checkout" style="margin-top:12px;width:100%">Buscar Pedidos</button>
  </form>

  @if (Model.Buscou)
  {
    if (Model.Pedidos.Count == 0)
    {
      <div class="admin-panel" style="text-align:center;color:var(--text-light)">
        Nenhum pedido encontrado para este telefone.
      </div>
    }
    else
    {
      @foreach (var pedido in Model.Pedidos)
      {
        <div class="admin-panel" style="margin-bottom:16px">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
            <div>
              <strong style="font-size:1.1rem">Pedido #@pedido.Id[..8]</strong>
              <div style="font-size:0.85rem;color:var(--text-light)">@pedido.CreatedAt</div>
            </div>
            @{
              var statusLabel = pedido.Status switch
              {
                "pending" => "Pendente",
                "paid" => "Pago",
                "preparing" => "Preparando",
                "delivering" => "Saiu para entrega",
                "delivered" => "Entregue",
                "cancelled" => "Cancelado",
                _ => pedido.Status
              };
              var statusColor = pedido.Status switch
              {
                "paid" => "#27ae60",
                "preparing" => "#f39c12",
                "delivering" => "#3498db",
                "delivered" => "#27ae60",
                "cancelled" => "#e74c3c",
                _ => "var(--accent)"
              };
            }
            <span style="display:inline-block;padding:4px 14px;border-radius:50px;font-size:0.85rem;font-weight:700;background:@statusColor;color:#fff">@statusLabel</span>
          </div>

          <div style="margin-top:12px;font-size:0.9rem;display:flex;gap:16px;flex-wrap:wrap">
            <span><strong>Total:</strong> R$ @pedido.Total.ToString("F2")</span>
            <span><strong>Pagamento:</strong> @(pedido.PaymentMethod switch { "card" => "Cartão de Crédito", "pix" => "PIX", "cash" => "Dinheiro", _ => pedido.PaymentMethod })</span>
          </div>

          <div style="margin-top:12px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <a href="/Rastreio?PedidoId=@pedido.Id" style="color:var(--brand);font-weight:600;text-decoration:none">📦 Acompanhar Pedido →</a>
            @if (pedido.Status == "pending" || pedido.Status == "paid")
            {
              <form method="post" asp-page="/Rastreio" asp-page-handler="cancel" onsubmit="return confirm('Tem certeza que deseja cancelar este pedido?')" style="display:inline">
                <input type="hidden" name="orderId" value="@pedido.Id" />
                <input type="hidden" name="telefone" value="@Model.Telefone" />
                <button type="submit" style="padding:6px 16px;background:#e74c3c;color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer;font-size:0.8rem">
                  Cancelar
                </button>
              </form>
            }
            <button onclick="reorder('@pedido.Items.Replace("'", "\\'")')" style="padding:6px 16px;background:var(--accent);color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer;font-size:0.8rem">
              🔄 Pedir Novamente
            </button>
          </div>
        </div>
      }
    }
  }
</div>

<script>
function reorder(itemsJson) {
  try {
    const data = JSON.parse(itemsJson);
    let cart = [];

    if (Array.isArray(data)) {
      cart = data;
    } else if (data.cart && Array.isArray(data.cart)) {
      cart = data.cart;
    }

    if (cart.length === 0) {
      alert('Não foi possível recuperar os itens do pedido.');
      return;
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    window.location.href = '/Carrinho';
  } catch (e) {
    alert('Erro ao recuperar itens do pedido.');
  }
}
</script>
