@page
@model OrderModel
@{
    Layout = "_Layout";
}

<div class="admin-page">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">Pedido @(Model.Id?.Length > 8 ? Model.Id[..8] : Model.Id)</h2>
      <button onclick="window.print()" class="btn-print" style="padding:8px 20px;background:var(--accent);color:#fff;border:none;border-radius:50px;font-weight:600;cursor:pointer">🖨️ Imprimir</button>
    </div>

    <div class="admin-panel">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
        <div>
          <p><strong>Cliente:</strong> @Model.CustomerName</p>
          <p><strong>Telefone:</strong> @Model.CustomerPhone</p>
          <p><strong>E-mail:</strong> @Model.CustomerEmail</p>
          <p><strong>Endereço:</strong> @Model.CustomerAddress</p>
          <p><strong>CPF:</strong> @Model.CustomerCPF</p>
          @if (!string.IsNullOrEmpty(Model.CustomerNotes))
          {
            <p><strong>Observações:</strong> @Model.CustomerNotes</p>
          }
        </div>
        <div>
          <p><strong>Criado:</strong> @Model.CreatedAt</p>
          @if (!string.IsNullOrEmpty(Model.ScheduledTime))
          {
            <p><strong>Agendado:</strong> @Model.ScheduledTime</p>
          }
          <p><strong>Status:</strong> <span style="color:var(--brand);font-weight:700">
            @{
              var statusLabel = Model.Status switch
              {
                "pending" => "Pendente",
                "paid" => "Pago",
                "preparing" => "Preparando",
                "delivering" => "Saiu para entrega",
                "delivered" => "Entregue",
                "cancelled" => "Cancelado",
                _ => Model.Status
              };
            }
            @statusLabel
          </span></p>
          <p><strong>Pagamento:</strong>
            @{
              var paymentLabel = Model.PaymentMethod switch
              {
                "card" => "Cartão de Crédito",
                "pix" => "PIX",
                "cash" => "Dinheiro",
                _ => Model.PaymentMethod
              };
            }
            @paymentLabel
          </p>
          @if (!string.IsNullOrEmpty(Model.CouponCode))
          {
            <p><strong>Cupom:</strong> @Model.CouponCode (-R$ @Model.Discount.ToString("F2"))</p>
          }
          @if (!string.IsNullOrEmpty(Model.DeliveryPersonName))
          {
            <p><strong>Entregador:</strong> @Model.DeliveryPersonName</p>
          }
        </div>
      </div>
    </div>

    <div class="admin-panel">
      <h3>Itens do Pedido</h3>
      <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Produto</th>
            <th>Tamanho</th>
            <th>Complementos</th>
            <th>Qtd</th>
            <th>Preço Unit.</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Items.Count > 0)
          {
            decimal calcSubtotal = 0;
            @foreach (var item in Model.Items)
            {
              var st = item.Price * item.Qty;
              calcSubtotal += st;
              <tr>
                <td>@item.Name</td>
                <td>@item.Size</td>
                <td>@item.Complements</td>
                <td>@item.Qty</td>
                <td>R$ @item.Price.ToString("F2")</td>
                <td>R$ @st.ToString("F2")</td>
              </tr>
            }
          }
          else
          {
            <tr><td colspan="6">Itens não disponíveis</td></tr>
          }
        </tbody>
      </table>
      </div>
      <div style="margin-top:16px;border-top:2px solid var(--text);padding-top:12px">
        <p><strong>Subtotal:</strong> R$ @Model.Subtotal.ToString("F2")</p>
        @if (Model.Discount > 0)
        {
          <p><strong>Desconto:</strong> -R$ @Model.Discount.ToString("F2")</p>
        }
        <p><strong>Frete:</strong> R$ @Model.DeliveryFee.ToString("F2")</p>
        <p style="font-size:1.1rem"><strong>Total:</strong> R$ @Model.Total.ToString("F2")</p>
      </div>
    </div>

    @if (Model.Status == "pending" && (Model.PaymentMethod == "pix" || Model.PaymentMethod == "cash"))
    {
      <div class="admin-panel" style="border:2px solid var(--accent);background:#fff9e6">
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <div style="flex:1">
            <strong style="font-size:1.1rem">💰 Pagamento @(Model.PaymentMethod == "pix" ? "PIX" : "em Dinheiro") pendente</strong>
            <p style="margin:4px 0 0;color:var(--text-light);font-size:0.85rem">Confirme manualmente quando o pagamento for recebido.</p>
          </div>
          <form method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="status" value="paid" />
            <button type="submit" style="background:#27ae60;color:#fff;border:none;padding:10px 24px;border-radius:50px;font-weight:700;cursor:pointer;font-size:1rem">
              ✅ Confirmar Pagamento
            </button>
          </form>
        </div>
      </div>
    }

    <form method="post" class="admin-panel">
      @Html.AntiForgeryToken()
      <h3>Atualizar Status</h3>
      <div style="display:flex;gap:12px;align-items:end;flex-wrap:wrap">
        <div style="flex:1">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="pending" selected="@(Model.Status == "pending")">Pendente</option>
            <option value="paid" selected="@(Model.Status == "paid")">Pago</option>
            <option value="preparing" selected="@(Model.Status == "preparing")">Preparando</option>
            <option value="delivering" selected="@(Model.Status == "delivering")">Saiu para entrega</option>
            <option value="delivered" selected="@(Model.Status == "delivered")">Entregue</option>
            <option value="cancelled" selected="@(Model.Status == "cancelled")">Cancelado</option>
          </select>
        </div>
        <div>
          <button type="submit">Salvar</button>
          <button type="submit" formaction="?delete=1" onclick="return confirm('Deletar pedido?')" style="background:#e74c3c">Deletar</button>
          <a href="/Admin/Orders" style="display:inline-block;padding:8px 20px;border:1px solid var(--border);border-radius:50px;text-decoration:none;color:var(--text);font-weight:600">← Voltar</a>
        </div>
      </div>
    </form>

    <div class="admin-panel">
      <h3>🏍️ Atribuir Entregador</h3>
      <div style="display:flex;gap:12px;align-items:end;flex-wrap:wrap">
        <div style="flex:1">
          <label for="delivery-person-select">Entregador</label>
          <select id="delivery-person-select">
            <option value="">Selecione um entregador...</option>
          </select>
        </div>
        <div>
          <button id="assign-delivery-btn" type="button" style="background:var(--accent)">Atribuir</button>
        </div>
      </div>
      <div id="assign-result" style="margin-top:8px;font-size:0.85rem"></div>
    </div>
  </div>
</div>

<script>
async function loadDeliveryPersons() {
  try {
    const r = await fetch('/api/delivery-persons/available');
    const list = await r.json();
    const sel = document.getElementById('delivery-person-select');
    sel.innerHTML = '<option value="">Selecione um entregador...</option>' +
      list.map(p => `<option value="${p.id}" data-name="${p.name}">${p.name} ${p.vehicle ? '('+p.vehicle+')' : ''}</option>`).join('');
  } catch {}
}

document.getElementById('assign-delivery-btn')?.addEventListener('click', async () => {
  const sel = document.getElementById('delivery-person-select');
  const id = sel.value;
  if (!id) { document.getElementById('assign-result').innerHTML = '<span style="color:var(--brand)">Selecione um entregador</span>'; return; }
  const name = sel.options[sel.selectedIndex].dataset.name;
  try {
    const r = await fetch('/api/orders/@Model.Id/assign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ personId: Number(id), personName: name })
    });
    if (r.ok) {
      document.getElementById('assign-result').innerHTML = '<span style="color:#27ae60">✓ Entregador atribuído!</span>';
      setTimeout(() => location.reload(), 1000);
    }
  } catch { document.getElementById('assign-result').innerHTML = '<span style="color:var(--brand)">Erro ao atribuir</span>'; }
});

loadDeliveryPersons();
</script>
