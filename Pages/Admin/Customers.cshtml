@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@{
  Layout = "_Layout";
}

<div class="admin-page">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">👥 Clientes</h2>
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
        <a href="/Admin/Index" style="color:var(--text-light);font-weight:600;text-decoration:none">Dashboard</a>
        <a href="/Admin/Orders" style="color:var(--text-light);font-weight:600;text-decoration:none">Pedidos</a>
        <a href="/Admin/Logout" style="color:#e74c3c;font-weight:600;text-decoration:none;font-size:0.85rem">Sair</a>
      </div>
    </div>

    <div class="admin-panel" style="margin-bottom:16px">
      <form id="search-form" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
        <div style="flex:1;min-width:140px">
          <label for="name">Nome</label>
          <input id="name" name="name" placeholder="Buscar por nome" />
        </div>
        <div style="flex:1;min-width:140px">
          <label for="phone">Telefone</label>
          <input id="phone" name="phone" placeholder="Buscar por telefone" />
        </div>
        <div style="display:flex;gap:8px">
          <button type="submit">Buscar</button>
        </div>
      </form>
    </div>

    <div class="admin-panel">
      <div id="customers-list">Carregando...</div>
    </div>
  </div>
</div>

<script>
async function loadCustomers(name, phone) {
  const el = document.getElementById('customers-list');
  try {
    let url = '/api/customers/search?';
    if (name) url += 'name=' + encodeURIComponent(name) + '&';
    if (phone) url += 'phone=' + encodeURIComponent(phone);
    if (!name && !phone) url = '/api/customers';
    const r = await fetch(url);
    const list = await r.json();
    if (!list.length) { el.innerText = 'Nenhum cliente encontrado.'; return; }
    el.innerHTML = `<div class="admin-table-wrap"><table class="admin-table">
      <thead><tr><th>Nome</th><th>Telefone</th><th>Email</th><th>Pedidos</th><th>Total Gasto</th><th>Último Pedido</th><th>Ações</th></tr></thead><tbody>${list.map(c => `
        <tr>
          <td class="td-name">${c.name}</td>
          <td>${c.phone || '-'}</td>
          <td>${c.email || '-'}</td>
          <td>${c.totalOrders}</td>
          <td>R$ ${c.totalSpent.toFixed(2)}</td>
          <td style="font-size:0.8rem">${c.lastOrderAt ? new Date(c.lastOrderAt).toLocaleDateString('pt-BR') : '-'}</td>
          <td><button data-id="${c.id}" class="btn-sm btn-view-customer">Detalhes</button></td>
        </tr>`).join('')}
      </tbody></table></div>`;
    document.querySelectorAll('.btn-view-customer').forEach(b => b.addEventListener('click', async (e) => {
      const id = Number(e.currentTarget.dataset.id);
      showCustomerDetail(id);
    }));
  } catch { el.innerText = 'Erro ao carregar'; }
}

async function showCustomerDetail(id) {
  try {
    const r = await fetch('/api/customers/' + id);
    const c = await r.json();
    const oR = await fetch('/api/customers/' + id + '/orders');
    const orders = await oR.json();

    const modal = document.createElement('div');
    modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
    modal.innerHTML = `
      <div style="background:#fff;border-radius:16px;max-width:600px;width:100%;max-height:80vh;overflow-y:auto;padding:24px">
        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:16px">
          <h3 style="margin:0">${c.name}</h3>
          <button onclick="this.closest('#modal-wrap').remove()" style="background:none;border:none;font-size:1.5rem;cursor:pointer">✕</button>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
          <div><strong>Telefone:</strong> ${c.phone || '-'}</div>
          <div><strong>Email:</strong> ${c.email || '-'}</div>
          <div><strong>Endereço:</strong> ${c.address || '-'}</div>
          <div><strong>CPF:</strong> ${c.cpf || '-'}</div>
          <div><strong>Pedidos:</strong> ${c.totalOrders}</div>
          <div><strong>Total Gasto:</strong> R$ ${c.totalSpent.toFixed(2)}</div>
          <div><strong>Primeiro Pedido:</strong> ${c.firstOrderAt ? new Date(c.firstOrderAt).toLocaleDateString('pt-BR') : '-'}</div>
          <div><strong>Último Pedido:</strong> ${c.lastOrderAt ? new Date(c.lastOrderAt).toLocaleDateString('pt-BR') : '-'}</div>
        </div>
        <div style="margin-bottom:16px">
          <label><strong>Observações</strong></label>
          <textarea id="customer-notes" style="width:100%;margin-top:4px" rows="2">${c.notes || ''}</textarea>
          <button onclick="saveNotes(${c.id})" style="margin-top:4px;font-size:0.85rem">Salvar Observações</button>
        </div>
        <h4 style="margin-bottom:8px">Últimos Pedidos</h4>
        ${orders.length === 0 ? '<p style="color:var(--text-light)">Nenhum pedido encontrado.</p>' :
          orders.map(o => `
            <div style="padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
              <div>
                <strong>#${o.id.slice(0,8)}</strong>
                <span style="font-size:0.8rem;color:var(--text-light);margin-left:8px">${new Date(o.createdAt).toLocaleDateString('pt-BR')}</span>
              </div>
              <div>
                <span style="font-weight:600">R$ ${o.total.toFixed(2)}</span>
                <span style="display:inline-block;padding:1px 8px;border-radius:50px;font-size:0.75rem;background:${o.status === 'delivered' ? '#27ae60' : o.status === 'cancelled' ? '#e74c3c' : 'var(--accent)'};color:#fff;margin-left:8px">${{'pending':'Pendente','paid':'Pago','preparing':'Preparando','delivering':'Saiu pra entrega','delivered':'Entregue','cancelled':'Cancelado'}[o.status] || o.status}</span>
                <a href="/Admin/Order?id=${o.id}" style="margin-left:8px;font-size:0.8rem">Ver</a>
              </div>
            </div>
          `).join('')
        }
      </div>`;
    modal.id = 'modal-wrap';
    document.body.appendChild(modal);
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
  } catch { alert('Erro ao carregar detalhes'); }
}

window.saveNotes = async function(customerId) {
  const notes = document.getElementById('customer-notes').value;
  try {
    await fetch('/api/customers/' + customerId + '/notes', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ notes })
    });
    alert('Observações salvas!');
  } catch { alert('Erro ao salvar'); }
};

document.getElementById('search-form').addEventListener('submit', (e) => {
  e.preventDefault();
  const name = document.getElementById('name').value;
  const phone = document.getElementById('phone').value;
  loadCustomers(name, phone);
});

loadCustomers();
</script>
