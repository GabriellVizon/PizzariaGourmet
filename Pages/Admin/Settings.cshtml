@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@{
  Layout = "_Layout";
}

<div class="admin-page">
  <div class="container" style="max-width:500px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">⚙️ Configurações</h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
        <a href="/Admin/Index" style="color:var(--text-light);font-weight:600;text-decoration:none">Dashboard</a>
        <a href="/Admin/Orders" style="color:var(--text-light);font-weight:600;text-decoration:none">Pedidos</a>
        <a href="/Admin/Logout" style="color:#e74c3c;font-weight:600;text-decoration:none;font-size:0.85rem">Sair</a>
      </div>
    </div>

    <div class="admin-panel">
      <form id="settings-form">
        <div class="form-group">
          <label for="deliveryFee">Taxa de entrega (mototaxi) — R$</label>
          <input id="deliveryFee" name="deliveryFee" type="number" step="0.01" min="0" required />
        </div>
        <div class="form-group">
          <label for="freeDeliveryMin">Frete grátis a partir de — R$</label>
          <input id="freeDeliveryMin" name="freeDeliveryMin" type="number" step="0.01" min="0" required />
          <small style="color:var(--text-light)">Se o valor for 0, o frete nunca será grátis.</small>
        </div>
        <div class="form-group">
          <label for="whatsapp">WhatsApp da loja</label>
          <input id="whatsapp" name="whatsapp" placeholder="5524992206707" />
          <small style="color:var(--text-light)">DDD + número, apenas dígitos</small>
        </div>
        <div class="form-group">
          <label for="estimatedTime">Tempo estimado de entrega (minutos)</label>
          <input id="estimatedTime" name="estimatedTime" type="number" min="1" value="60" />
          <small style="color:var(--text-light)">Exibido na confirmação do pedido</small>
        </div>
        <div class="form-group">
          <label for="pixKey">Chave PIX</label>
          <input id="pixKey" name="pixKey" placeholder="chave@email.com" />
        </div>
        <div class="form-group">
          <label for="storeName">Nome da loja</label>
          <input id="storeName" name="storeName" placeholder="Pizzaria Gourmet" />
        </div>
        <div class="form-group">
          <label for="address">Endereço da loja</label>
          <input id="address" name="address" placeholder="Rua Exemplo, 123 - Centro" />
        </div>
        <div class="form-group">
          <label for="cnpj">CNPJ</label>
          <input id="cnpj" name="cnpj" placeholder="00.000.000/0001-00" />
        </div>
        <div class="form-group">
          <label>
            <input id="allowScheduling" name="allowScheduling" type="checkbox" style="width:auto" />
            Permitir agendamento de pedidos
          </label>
        </div>
        <div class="form-group">
          <label for="minScheduleMinutes">Mínimo para agendamento (minutos)</label>
          <input id="minScheduleMinutes" name="minScheduleMinutes" type="number" min="0" value="60" />
          <small style="color:var(--text-light)">Tempo mínimo de antecedência para agendar um pedido</small>
        </div>
        <div style="margin-top:16px">
          <button type="submit">Salvar</button>
          <span id="settings-result" style="margin-left:12px;font-size:0.85rem"></span>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
async function loadSettings() {
  try {
    const r = await fetch('/api/settings');
    const s = await r.json();
    document.getElementById('deliveryFee').value = s.deliveryFee;
    document.getElementById('freeDeliveryMin').value = s.freeDeliveryMin;
    document.getElementById('whatsapp').value = s.whatsapp || '';
    document.getElementById('pixKey').value = s.pixKey || '';
    document.getElementById('storeName').value = s.storeName || '';
    document.getElementById('address').value = s.address || '';
    document.getElementById('cnpj').value = s.cnpj || '';
    document.getElementById('allowScheduling').checked = s.allowScheduling !== false;
    document.getElementById('minScheduleMinutes').value = s.minScheduleMinutes || 60;
    document.getElementById('estimatedTime').value = s.estimatedTime || 60;
  } catch {}
}

document.getElementById('settings-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button');
  btn.disabled = true;
  const result = document.getElementById('settings-result');
  try {
    const r = await fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        deliveryFee: Number(document.getElementById('deliveryFee').value),
        freeDeliveryMin: Number(document.getElementById('freeDeliveryMin').value),
        whatsapp: document.getElementById('whatsapp').value,
        pixKey: document.getElementById('pixKey').value,
        storeName: document.getElementById('storeName').value,
        address: document.getElementById('address').value,
        cnpj: document.getElementById('cnpj').value,
        allowScheduling: document.getElementById('allowScheduling').checked,
        minScheduleMinutes: Number(document.getElementById('minScheduleMinutes').value) || 60,
        estimatedTime: Number(document.getElementById('estimatedTime').value) || 60
      })
    });
    if (r.status === 401) { window.location.href = '/Admin/Login'; return; }
    result.textContent = '✓ Salvo!';
    result.style.color = '#27ae60';
  } catch {
    result.textContent = '✕ Erro ao salvar';
    result.style.color = 'var(--brand)';
  }
  btn.disabled = false;
  setTimeout(() => result.textContent = '', 3000);
});

loadSettings();
</script>
