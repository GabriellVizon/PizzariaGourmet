@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@{
  Layout = "_Layout";
}

<div class="admin-page">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">📊 Relatórios de Vendas</h2>
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
        <a href="/Admin/Index" style="color:var(--text-light);font-weight:600;text-decoration:none">Dashboard</a>
        <a href="/Admin/Orders" style="color:var(--text-light);font-weight:600;text-decoration:none">Pedidos</a>
        <a href="/Admin/Logout" style="color:#e74c3c;font-weight:600;text-decoration:none;font-size:0.85rem">Sair</a>
      </div>
    </div>

    <div class="admin-panel" style="margin-bottom:16px">
      <form id="report-filters" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
        <div style="min-width:130px">
          <label for="dateFrom">De</label>
          <input id="dateFrom" type="date" />
        </div>
        <div style="min-width:130px">
          <label for="dateTo">Até</label>
          <input id="dateTo" type="date" />
        </div>
        <div style="display:flex;gap:8px">
          <button type="submit">Gerar Relatório</button>
          <button type="button" id="export-csv" style="background:var(--accent)">Exportar CSV</button>
        </div>
      </form>
    </div>

    <div id="report-content">
      <div style="text-align:center;padding:40px;color:var(--text-light)">Clique em "Gerar Relatório" para visualizar os dados.</div>
    </div>
  </div>
</div>

<style>
.report-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:20px }
.report-card { background:var(--bg);border-radius:var(--radius-sm);padding:16px;text-align:center }
.report-card .value { font-size:1.5rem;font-weight:800;color:var(--brand) }
.report-card .label { font-size:0.8rem;color:var(--text-light);margin-top:4px }
.report-section { margin-bottom:24px }
.report-section h3 { margin-bottom:12px;font-size:1rem }
</style>

<script>
async function loadReport(dateFrom, dateTo) {
  const el = document.getElementById('report-content');
  el.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-light)">Carregando...</div>';
  try {
    let url = '/api/reports?';
    if (dateFrom) url += 'dateFrom=' + encodeURIComponent(dateFrom) + '&';
    if (dateTo) url += 'dateTo=' + encodeURIComponent(dateTo);
    const r = await fetch(url);
    const data = await r.json();
    if (r.status === 401) { window.location.href = '/Admin/Login'; return; }

    el.innerHTML = `
      <div class="report-grid">
        <div class="report-card">
          <div class="value">R$ ${data.totalRevenue.toFixed(2)}</div>
          <div class="label">Faturamento Total</div>
        </div>
        <div class="report-card">
          <div class="value">${data.totalOrders}</div>
          <div class="label">Pedidos</div>
        </div>
        <div class="report-card">
          <div class="value">R$ ${data.avgOrderValue.toFixed(2)}</div>
          <div class="label">Ticket Médio</div>
        </div>
        <div class="report-card">
          <div class="value">${data.cancelledOrders}</div>
          <div class="label">Cancelados</div>
        </div>
        <div class="report-card">
          <div class="value">R$ ${data.totalDiscounts.toFixed(2)}</div>
          <div class="label">Descontos Concedidos</div>
        </div>
      </div>

      <div class="report-section">
        <h3>📈 Vendas por Dia</h3>
        ${data.dailySales && data.dailySales.length > 0 ? `
        <div class="admin-table-wrap"><table class="admin-table">
          <thead><tr><th>Data</th><th>Pedidos</th><th>Faturamento</th></tr></thead>
          <tbody>${data.dailySales.map(d => `
            <tr>
              <td>${new Date(d.date+'T12:00:00').toLocaleDateString('pt-BR')}</td>
              <td>${d.orders}</td>
              <td>R$ ${d.revenue.toFixed(2)}</td>
            </tr>
          `).join('')}</tbody>
        </table></div>
        ` : '<p style="color:var(--text-light)">Nenhum dado disponível.</p>'}
      </div>

      <div class="report-section">
        <h3>🏆 Produtos Mais Vendidos</h3>
        ${data.topProducts && data.topProducts.length > 0 ? `
        <div class="admin-table-wrap"><table class="admin-table">
          <thead><tr><th>Produto</th><th>Quantidade</th><th>Faturamento</th></tr></thead>
          <tbody>${data.topProducts.map(p => `
            <tr>
              <td class="td-name">${p.name}</td>
              <td>${p.quantity}</td>
              <td>R$ ${p.revenue.toFixed(2)}</td>
            </tr>
          `).join('')}</tbody>
        </table></div>
        ` : '<p style="color:var(--text-light)">Nenhum dado disponível.</p>'}
      </div>

      <div class="report-section">
        <h3>💳 Formas de Pagamento</h3>
        ${data.paymentBreakdown && data.paymentBreakdown.length > 0 ? `
        <div class="admin-table-wrap"><table class="admin-table">
          <thead><tr><th>Método</th><th>Pedidos</th><th>Faturamento</th></tr></thead>
          <tbody>${data.paymentBreakdown.map(p => `
            <tr>
              <td>${p.method}</td>
              <td>${p.orders}</td>
              <td>R$ ${p.revenue.toFixed(2)}</td>
            </tr>
          `).join('')}</tbody>
        </table></div>
        ` : '<p style="color:var(--text-light)">Nenhum dado disponível.</p>'}
      </div>
    `;
    window._reportData = data;
  } catch {
    el.innerHTML = '<div style="text-align:center;padding:40px;color:var(--brand)">Erro ao carregar relatório.</div>';
  }
}

document.getElementById('report-filters').addEventListener('submit', (e) => {
  e.preventDefault();
  const dateFrom = document.getElementById('dateFrom').value;
  const dateTo = document.getElementById('dateTo').value;
  loadReport(dateFrom, dateTo);
});

document.getElementById('export-csv')?.addEventListener('click', () => {
  const data = window._reportData;
  if (!data) { alert('Gere um relatório primeiro.'); return; }
  let csv = '\uFEFF';
  csv += 'Indicador,Valor\n';
  csv += `Faturamento Total,R$ ${data.totalRevenue.toFixed(2)}\n`;
  csv += `Total de Pedidos,${data.totalOrders}\n`;
  csv += `Ticket Médio,R$ ${data.avgOrderValue.toFixed(2)}\n`;
  csv += `Cancelados,${data.cancelledOrders}\n`;
  csv += `Descontos,R$ ${data.totalDiscounts.toFixed(2)}\n\n`;
  csv += 'Vendas por Dia\n';
  csv += 'Data,Pedidos,Faturamento\n';
  if (data.dailySales) data.dailySales.forEach(d => {
    csv += `${d.date},${d.orders},R$ ${d.revenue.toFixed(2)}\n`;
  });
  csv += '\nProdutos Mais Vendidos\n';
  csv += 'Produto,Quantidade,Faturamento\n';
  if (data.topProducts) data.topProducts.forEach(p => {
    csv += `"${p.name}",${p.quantity},R$ ${p.revenue.toFixed(2)}\n`;
  });
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = 'relatorio_vendas.csv';
  link.click();
});

loadReport();
</script>
