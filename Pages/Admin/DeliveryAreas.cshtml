@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@{
  Layout = "_Layout";
}

<div class="admin-page">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">📍 Áreas de Entrega</h2>
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
        <a href="/Admin/Index" style="color:var(--text-light);font-weight:600;text-decoration:none">Dashboard</a>
        <a href="/Admin/Orders" style="color:var(--text-light);font-weight:600;text-decoration:none">Pedidos</a>
        <a href="/Admin/Settings" style="color:var(--text-light);font-weight:600;text-decoration:none">Config</a>
        <a href="/Admin/Logout" style="color:#e74c3c;font-weight:600;text-decoration:none;font-size:0.85rem">Sair</a>
      </div>
    </div>

    <div class="admin-panel">
      <form id="area-form">
        <input type="hidden" name="id" />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
          <div>
            <label>Nome da região</label>
            <input name="name" required placeholder="Ex: Centro" />
          </div>
          <div>
            <label>Bairro</label>
            <input name="neighborhood" placeholder="Ex: Centro" />
          </div>
          <div>
            <label>CEP início</label>
            <input name="cepStart" placeholder="25000000" />
          </div>
          <div>
            <label>CEP fim</label>
            <input name="cepEnd" placeholder="25999999" />
          </div>
          <div>
            <label>Taxa de entrega (R$)</label>
            <input name="deliveryFee" type="number" step="0.01" value="5.00" required />
          </div>
          <div>
            <label>Pedido mínimo (R$)</label>
            <input name="minOrder" type="number" step="0.01" value="0" />
          </div>
          <div>
            <label>Tempo estimado (min)</label>
            <input name="estimatedTime" type="number" value="60" />
          </div>
        </div>
        <div style="margin-top:12px;display:flex;gap:12px;align-items:center">
          <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer">
            <input name="isActive" type="checkbox" checked value="true" style="width:auto" />
            Ativo
          </label>
        </div>
        <div style="margin-top:12px">
          <button type="submit">Salvar</button>
          <button type="button" id="reset-area-form">Limpar</button>
        </div>
      </form>
    </div>

    <div class="admin-panel">
      <h3>Regiões Cadastradas</h3>
      <div id="areas-list">Carregando...</div>
    </div>
  </div>
</div>

<script>
async function loadAreas() {
  const el = document.getElementById('areas-list');
  try {
    const r = await fetch('/api/delivery-areas');
    const list = await r.json();
    if (!list.length) { el.innerText = 'Nenhuma área cadastrada.'; return; }
    el.innerHTML = `<div class="admin-table-wrap"><table class="admin-table">
      <thead><tr>
        <th>Nome</th><th>Bairro</th><th>CEP</th><th>Taxa</th><th>Pedido Mín</th><th>Tempo</th><th>Ativo</th><th>Ações</th>
      </tr></thead><tbody>${list.map(a => `
        <tr>
          <td>${a.name}</td>
          <td>${a.neighborhood || '-'}</td>
          <td>${a.cepStart || ''}${a.cepEnd ? ' ~ '+a.cepEnd : ''}</td>
          <td>R$ ${a.deliveryFee.toFixed(2)}</td>
          <td>${a.minOrder > 0 ? 'R$ '+a.minOrder.toFixed(2) : '-'}</td>
          <td>${a.estimatedTime}min</td>
          <td>${a.isActive ? '✅' : '❌'}</td>
          <td><button data-id="${a.id}" class="btn-sm btn-edit-area">Editar</button> <button data-id="${a.id}" class="btn-sm btn-del-area">Excluir</button></td>
        </tr>`).join('')}
      </tbody></table></div>`;
    document.querySelectorAll('.btn-edit-area').forEach(b => b.addEventListener('click', async (e) => {
      const id = Number(e.currentTarget.dataset.id);
      const r = await fetch('/api/delivery-areas/' + id);
      const a = await r.json();
      const f = document.getElementById('area-form');
      f.elements['id'].value = a.id;
      f.elements['name'].value = a.name;
      f.elements['neighborhood'].value = a.neighborhood || '';
      f.elements['cepStart'].value = a.cepStart || '';
      f.elements['cepEnd'].value = a.cepEnd || '';
      f.elements['deliveryFee'].value = a.deliveryFee;
      f.elements['minOrder'].value = a.minOrder;
      f.elements['estimatedTime'].value = a.estimatedTime;
      if (f.elements['isActive']) f.elements['isActive'].checked = a.isActive !== false;
    }));
    document.querySelectorAll('.btn-del-area').forEach(b => b.addEventListener('click', async (e) => {
      if (!confirm('Excluir área?')) return;
      const id = Number(e.currentTarget.dataset.id);
      await fetch('/api/delivery-areas/' + id, { method: 'DELETE' });
      loadAreas();
    }));
  } catch { el.innerText = 'Erro ao carregar'; }
}

document.getElementById('area-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = e.target;
  const id = f.elements['id'].value;
  const body = {
    name: f.elements['name'].value,
    neighborhood: f.elements['neighborhood'].value,
    cepStart: f.elements['cepStart'].value,
    cepEnd: f.elements['cepEnd'].value,
    deliveryFee: Number(f.elements['deliveryFee'].value),
    minOrder: Number(f.elements['minOrder'].value) || 0,
    estimatedTime: Number(f.elements['estimatedTime'].value) || 60,
    isActive: f.elements['isActive'] ? f.elements['isActive'].checked : true
  };
  try {
    if (id) {
      await fetch('/api/delivery-areas/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    } else {
      await fetch('/api/delivery-areas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    }
    f.reset();
    loadAreas();
  } catch { alert('Erro ao salvar'); }
});

document.getElementById('reset-area-form').addEventListener('click', () => {
  document.getElementById('area-form').reset();
});

loadAreas();
</script>
