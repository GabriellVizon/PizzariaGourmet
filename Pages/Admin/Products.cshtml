@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@{
  Layout = "_Layout";
}

<div class="admin-page">
  <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
        <h2 style="margin:0">Gerenciar Produtos</h2>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <a href="/Admin/Index" style="color:var(--text-light);font-weight:600;text-decoration:none">Dashboard</a>
          <a href="/Admin/Orders" style="color:var(--text-light);font-weight:600;text-decoration:none">Pedidos</a>
          <a href="/Admin/Complements" style="color:var(--brand);font-weight:600;text-decoration:none">Complementos</a>
          <a href="/Admin/Settings" style="color:var(--text-light);font-weight:600;text-decoration:none">Config</a>
          <a href="/Admin/Logout" style="color:#e74c3c;font-weight:600;text-decoration:none;font-size:0.85rem">Sair</a>
        </div>
      </div>

    <div class="admin-panel">
      <form id="product-form">
        <input type="hidden" name="id" />
        <div>
          <label>Nome</label>
          <input name="name" required />
        </div>
        <div>
          <label>Descrição</label>
          <textarea name="description" rows="2"></textarea>
        </div>
        <div>
          <label>Preço (R$)</label>
          <input name="price" type="number" step="0.01" required />
        </div>
        <div>
          <label>Imagem</label>
          <div style="display:flex;gap:8px;align-items:center">
            <input name="image" placeholder="https://... ou faça upload" style="flex:1" />
            <input type="file" id="image-file" accept="image/*" style="display:none" />
            <button type="button" id="upload-image-btn" style="background:var(--accent);padding:8px 16px;font-size:0.85rem">📁 Upload</button>
          </div>
          <small style="color:var(--text-light)">Cole uma URL ou faça upload de uma imagem</small>
        </div>
        <div id="size-editor"></div>
        <div>
          <label>Categoria</label>
          <select name="category">
            <option value="">Selecione</option>
            <option value="Clássica">Clássica</option>
            <option value="Especial">Especial</option>
            <option value="Premium">Premium</option>
            <option value="Bebida">Bebida</option>
          </select>
        </div>
        <div>
          <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer">
            <input name="available" type="checkbox" checked value="true" style="width:auto" />
            Disponível (mostrar no cardápio)
          </label>
        </div>
        <div style="margin-top:12px">
          <button id="save-product" type="submit">Salvar</button>
          <button id="reset-form" type="button">Limpar</button>
        </div>
      </form>
    </div>

    <div class="admin-panel">
      <h3>Produtos Cadastrados</h3>
      <div id="products-list">Carregando...</div>
    </div>
  </div>
</div>

<script src="/js/admin-products.js"></script>
