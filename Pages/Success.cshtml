@page
@{
  Layout = "_Layout";
}

<div class="success-page">
  <div class="success-icon">✓</div>
  <h2>Pedido Confirmado! 🎉</h2>
  <p>Seu pedido foi recebido com sucesso.</p>
  <p id="success-message" class="success-details">Processando...</p>
  <div style="margin-top:16px;padding:16px;background:var(--bg);border-radius:var(--radius-sm);display:inline-block">
    <p style="margin:0 0 8px;font-weight:600">📞 Precisa de ajuda?</p>
    <a href="https://wa.me/5524992206707" style="color:var(--brand);font-weight:700;text-decoration:none">Fale conosco no WhatsApp</a>
  </div>
  <div style="margin-top:24px">
    <a href="/" class="btn-home">← Voltar ao Cardápio</a>
  </div>
</div>

<script>
const params = new URLSearchParams(window.location.search);
const sessionId = params.get('session_id');
const orderId = params.get('order_id');

if (sessionId) {
  (async () => {
    try {
      const res = await fetch('/session/' + encodeURIComponent(sessionId));
      const json = await res.json();
      if (json.error) {
        document.getElementById('success-message').innerHTML = `
          Pagamento confirmado!<br>
          Em breve você receberá a confirmação por WhatsApp.
        `;
      } else {
        document.getElementById('success-message').innerHTML = `
          Pagamento confirmado via cartão.<br>
          ID da transação: <strong>${json.id.slice(0, 8)}...</strong><br>
          Em breve você receberá a confirmação por WhatsApp.
        `;
      }
      localStorage.removeItem('cart');
    } catch (e) {
      document.getElementById('success-message').innerText = 'Pagamento confirmado! Em breve você receberá a confirmação.';
    }
  })();
} else if (orderId) {
  document.getElementById('success-message').innerHTML = `
    Pedido registrado com sucesso!<br>
    Nº do pedido: <strong>#${orderId.slice(0, 8)}</strong><br>
    Pagamento será confirmado na entrega.
  `;
  localStorage.removeItem('cart');
} else {
  document.getElementById('success-message').innerText = 'Pedido registrado!';
  localStorage.removeItem('cart');
}
</script>
